# Copy this file to .env and adjust. The .env file is never committed.

# development | production (production refuses to start without login and PostgreSQL)
ENVIRONMENT=development

# SQLite locally; in production the Supabase connection string (Settings > Database)
DATABASE_URL=sqlite:///./sync.db

# Frontend addresses allowed to call the API (JSON list)
CORS_ORIGINS=["http://localhost:5173"]
# Optional pattern for more addresses, e.g. Vercel previews
CORS_ORIGIN_REGEX=

TIMEZONE=America/Sao_Paulo

# Google login through Supabase Auth. Empty = no login (development user)
SUPABASE_URL=
