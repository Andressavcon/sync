# Copy to .env.local and fill in. Never commit the real file.

# Backend address in production (empty in development: Vite sends /api to localhost:8000)
VITE_API_URL=

# Google login through Supabase Auth (empty = no login, development mode).
# Supabase dashboard > Project Settings > API: Project URL and the anon/publishable key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Public demo (no login, fictional data): "true" shows the demo badge in the header
VITE_DEMO=
